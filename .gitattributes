# Normalise every text file to LF inside the repository.
# The training / evaluation scripts are executed on a Linux cluster, where a
# CRLF line ending makes the shell scripts fail with "\r: command not found".
* text=auto eol=lf

*.py     text eol=lf
*.sh     text eol=lf
*.sbatch text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.toml   text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
.gitignore text eol=lf
